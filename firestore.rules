rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'danielgiobari644@gmail.com')
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId)
        || isAdmin()
      );
      allow delete: if isAdmin();

      match /user_rewards/{rewardId} {
        allow read: if true;
        allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow delete: if isAdmin();
      }
    }

    // --- Cell Groups ---
    match /cells/{cellId} {
      allow read: if true;
      allow create: if isVerified();
      allow update: if isVerified() || isAdmin();
      allow delete: if isAdmin();

      // Subcollection: Cell chat messages
      match /messages/{messageId} {
        allow read: if true;
        allow create, update: if isVerified() || isAdmin();
        allow delete: if isVerified() || isAdmin();
      }

      // Subcollection: Cell announcements
      match /announcements/{announcementId} {
        allow read: if true;
        allow create, update, delete: if isVerified() || isAdmin();
      }

      // Subcollection: Cell events
      match /events/{eventId} {
        allow read: if true;
        allow create, update, delete: if isVerified() || isAdmin();
      }
    }

    // --- Prayer Petitions ---
    match /prayer_petitions/{petitionId} {
      allow read: if true;
      allow create, update: if isVerified() || isAdmin();
      allow delete: if isVerified() || isAdmin();
    }

    // --- Parish Calendar Events ---
    match /parish_events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isVerified() || isAdmin();
    }

    // --- Bible Trivia & Quizzes ---
    match /trivia_questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quiz_scores/{scoreId} {
      allow read: if true;
      allow create, update: if isVerified() || isSignedIn();
      allow delete: if isAdmin();
    }

    match /quiz_reactions/{reactionId} {
      allow read: if true;
      allow create, update: if isVerified() || isSignedIn();
      allow delete: if isVerified() || isAdmin();
    }

    // --- Downloads Hub Bundles ---
    match /download_bundles/{bundleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- System Configuration Desk Setup & Live Stream Broadcast ---
    match /system_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // --- Loading Screen Configuration & History ---
    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    match /loading_screen_history/{historyId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // --- Community Feed & Social Center ---
    match /community_feed/{postId} {
      allow read: if true;
      allow create, update: if isVerified() || isSignedIn() || isAdmin();
      allow delete: if isVerified() || isAdmin();
    }

    // --- User Reviews ---
    match /user_reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isVerified() || isSignedIn();
      allow delete: if isVerified() || isAdmin();
    }

    // --- Featured Testimonies ---
    match /featured_testimonies/{testimonyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Live Streams & Replays ---
    match /live_streams/{streamId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    match /stream_replays/{replayId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /stream_chats/{chatId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /stream_viewers/{viewerId} {
      allow read, write: if true;
    }

    // --- Direct Admin Support Chat ---
    match /support_chats/{msgId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isSignedIn() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // --- Upcoming Events ---
    match /upcoming_events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Daily Devotionals ---
    match /daily_devotionals/{devotionalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Champions Referrals ---
    match /referrals/{referralId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // --- Realtime Member Presence ---
    match /presence/{userId} {
      allow read, write: if true;
    }

    // --- Champions Rewards Library ---
    match /user_rewards/{rewardId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- Referral Link Clicks Tracker ---
    match /referral_clicks/{clickId} {
      allow read, write: if true;
    }

    // --- Kingdom Store Products ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    match /storeProducts/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // --- Custom Creation Requests ---
    match /custom_requests/{requestId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Feedback Hub Items ---
    match /feedback_items/{feedbackId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // --- Kingdom Coin Transactions ---
    match /kc_transactions/{transactionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
  }
}
