rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'danielgiobari644@gmail.com')
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin')
      );
    }

    // --- User Profiles & Rewards ---
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      match /user_rewards/{rewardId} {
        allow read: if true;
        allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow delete: if isAdmin();
      }
    }

    // --- Mission Completions ---
    match /mission_completions/{completionId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- Kingdom Coin Transactions Audit Trail ---
    match /kc_transactions/{transactionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- Cell Groups & Chat ---
    match /cells/{cellId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if true;
        allow create, update: if isSignedIn() || isAdmin();
        allow delete: if isSignedIn() || isAdmin();
      }

      match /announcements/{announcementId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() || isAdmin();
      }

      match /events/{eventId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() || isAdmin();
      }
    }

    // --- Prayer Petitions ---
    match /prayer_petitions/{petitionId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isSignedIn() || isAdmin();
    }

    // --- Parish Events ---
    match /parish_events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() || isAdmin();
    }

    // --- Trivia Questions & Quizzes ---
    match /trivia_questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quiz_scores/{scoreId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /quiz_reactions/{reactionId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() || isAdmin();
    }

    // --- Download Bundles ---
    match /download_bundles/{bundleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- System Configs & Loading Screen ---
    match /system_configs/{configId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    match /loading_screen_history/{historyId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // --- Community Feed ---
    match /community_feed/{postId} {
      allow read: if true;
      allow create, update: if isSignedIn() || isAdmin();
      allow delete: if isSignedIn() || isAdmin();
    }

    // --- User Reviews ---
    match /user_reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() || isAdmin();
    }

    // --- Featured Testimonies ---
    match /featured_testimonies/{testimonyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Direct Support Chats ---
    match /support_chats/{msgId} {
      allow read, create: if isSignedIn() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // --- Upcoming Events & Devotionals ---
    match /upcoming_events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isSignedIn() || isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isSignedIn() || isAdmin();
    }

    match /daily_devotionals/{devotionalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /devotionals/{devotionalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Referrals & Presence ---
    match /referrals/{referralId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    match /referral_clicks/{clickId} {
      allow read, write: if true;
    }

    match /presence/{userId} {
      allow read, write: if true;
    }

    // --- Kingdom Store Products, Purchases & User Rewards ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    match /storeProducts/{productId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    match /purchases/{purchaseId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /user_rewards/{rewardId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- Custom Requests & Feedback ---
    match /custom_requests/{requestId} {
      allow read, create, update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /feedback_items/{feedbackId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // --- Custom Quizzes & Devotional Reads ---
    match /custom_quizzes/{quizId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();

      match /participants/{participantId} {
        allow read, write: if isSignedIn() || isAdmin();
      }

      match /chat/{chatId} {
        allow read, write: if isSignedIn() || isAdmin();
      }
    }

    match /devotional_reads/{readId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }
  }
}
