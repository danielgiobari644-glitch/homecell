rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'danielgiobari644@gmail.com')
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Super Admin')
        || (exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
      );
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      match /notes/{noteId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Home Fellowships ---
    match /fellowships/{fellowshipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }
    }

    // --- Fellowship Memberships (User <-> Fellowship with Role) ---
    match /memberships/{membershipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- Global Feed Posts (with author fellowship identity) ---
    match /global_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // Legacy feed backward compatibility
    match /community_feed/{postId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // --- Global Chat Messages (Cross-fellowship) ---
    match /global_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // --- Private Fellowship Messages ---
    match /fellowship_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // --- Fellowship Quizzes ---
    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Legacy quizzes
    match /custom_quizzes/{quizId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() || isAdmin();

      match /participants/{participantId} {
        allow read, write: if isSignedIn();
      }
      match /chat/{chatId} {
        allow read, write: if isSignedIn();
      }
    }

    // --- Quiz Attempts & Scores ---
    match /quiz_attempts/{attemptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /quiz_scores/{scoreId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- Fellowship Events & Gatherings ---
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() || isAdmin();
    }

    // --- Prayer Petitions & Wall ---
    match /prayer_petitions/{petitionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() || isAdmin();
    }

    // --- Cloudinary Media Records ---
    match /media/{mediaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.uploadedBy == request.auth.uid || isAdmin());
    }

    // --- Devotionals & Scripture Study ---
    match /daily_devotionals/{devotionalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /devotionals/{devotionalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_notes/{noteId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (resource == null || resource.data.userUid == request.auth.uid || isAdmin());
    }

    // Legacy cells compat
    match /cells/{cellId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
