{
  "entities": {
    "User": {
      "title": "User",
      "description": "Global user profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["Member", "Super Admin"] },
        "streak": { "type": "number" },
        "chaptersReadCount": { "type": "number" },
        "quizWinsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email"]
    },
    "Fellowship": {
      "title": "Fellowship",
      "description": "Individual Home Fellowship community.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "motto": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "day": { "type": "string" },
        "time": { "type": "string" },
        "phone": { "type": "string" },
        "leaderId": { "type": "string" },
        "leaderName": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "memberCount": { "type": "number" },
        "additionalInfo": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "address", "leaderId", "leaderName"]
    },
    "Membership": {
      "title": "Membership",
      "description": "User association and role within a specific Home Fellowship.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fellowshipId": { "type": "string" },
        "fellowshipName": { "type": "string" },
        "fellowshipMotto": { "type": "string" },
        "userDisplayName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPhotoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["leader", "moderator", "member"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fellowshipId", "role"]
    },
    "GlobalPost": {
      "title": "GlobalPost",
      "description": "Post shared on the Global Feed with author fellowship identity marker.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "fellowshipId": { "type": "string" },
        "fellowshipName": { "type": "string" },
        "content": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string" },
        "type": { "type": "string", "enum": ["post", "testimony", "announcement"] },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "content", "fellowshipId", "fellowshipName"]
    },
    "GlobalMessage": {
      "title": "GlobalMessage",
      "description": "Real-time message in the Global Home.cell Chat with fellowship marker.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "fellowshipId": { "type": "string" },
        "fellowshipName": { "type": "string" },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "text", "fellowshipId", "fellowshipName"]
    },
    "FellowshipMessage": {
      "title": "FellowshipMessage",
      "description": "Private message inside a specific fellowship environment.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fellowshipId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fellowshipId", "authorId", "authorName", "text"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Fellowship-specific scripture and bible knowledge quiz challenge.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "fellowshipId": { "type": "string" },
        "fellowshipName": { "type": "string" },
        "createdBy": { "type": "string" },
        "creatorName": { "type": "string" },
        "questions": { "type": "array" },
        "timeLimit": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "fellowshipId", "createdBy", "questions"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Record of a user taking a fellowship quiz.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quizId": { "type": "string" },
        "quizTitle": { "type": "string" },
        "fellowshipId": { "type": "string" },
        "fellowshipName": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["quizId", "userId", "score"]
    },
    "Event": {
      "title": "Event",
      "description": "Fellowship gathering, rally, or meeting.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fellowshipId": { "type": "string" },
        "fellowshipName": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fellowshipId", "title", "date", "time"]
    },
    "MediaRecord": {
      "title": "MediaRecord",
      "description": "Cloudinary media record stored in Firestore.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "publicId": { "type": "string" },
        "type": { "type": "string" },
        "bytes": { "type": "number" },
        "format": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "uploadedByName": { "type": "string" },
        "purpose": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["url", "uploadedBy", "purpose"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Global user accounts."
    },
    "fellowships/{fellowshipId}": {
      "schema": "Fellowship",
      "description": "Home fellowship communities."
    },
    "memberships/{membershipId}": {
      "schema": "Membership",
      "description": "User-fellowship memberships and roles."
    },
    "global_posts/{postId}": {
      "schema": "GlobalPost",
      "description": "Global feed posts with fellowship identity."
    },
    "global_messages/{messageId}": {
      "schema": "GlobalMessage",
      "description": "Cross-fellowship global chat messages."
    },
    "fellowship_messages/{messageId}": {
      "schema": "FellowshipMessage",
      "description": "Private fellowship chat messages."
    },
    "quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Fellowship-specific quizzes."
    },
    "quiz_attempts/{attemptId}": {
      "schema": "QuizAttempt",
      "description": "Fellowship quiz attempt scoring records."
    },
    "events/{eventId}": {
      "schema": "Event",
      "description": "Fellowship gatherings and events."
    },
    "media/{mediaId}": {
      "schema": "MediaRecord",
      "description": "Cloudinary media audit records."
    },
    "prayer_petitions/{petitionId}": {
      "schema": "GlobalPost",
      "description": "Prayer petitions."
    },
    "daily_devotionals/{devotionalId}": {
      "schema": "GlobalPost",
      "description": "Daily devotional scripture studies."
    }
  }
}
