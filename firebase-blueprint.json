{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered user profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "coordinates": { "type": "string" },
        "role": { "type": "string", "enum": ["Member", "Cell Leader", "Cell Coordinator", "Pastor", "Super Admin"] },
        "cellId": { "type": "string" },
        "kingdomCoins": { "type": "number" },
        "totalKcEarned": { "type": "number" },
        "streak": { "type": "number" },
        "longestStreak": { "type": "number" },
        "totalDevotions": { "type": "number" },
        "chaptersReadCount": { "type": "number" },
        "quizWinsCount": { "type": "number" },
        "storePurchases": { "type": "number" },
        "equippedTheme": { "type": "string" },
        "onboarded": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "cellId"]
    },
    "MissionCompletion": {
      "title": "MissionCompletion",
      "description": "Unique historical completion and reward record for a user mission.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userUid": { "type": "string" },
        "missionId": { "type": "string" },
        "date": { "type": "string" },
        "rewardKC": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userUid", "missionId", "rewardKC"]
    },
    "KcTransaction": {
      "title": "KcTransaction",
      "description": "Audit record of Kingdom Coins earned or spent.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userUid": { "type": "string" },
        "type": { "type": "string", "enum": ["credit", "debit"] },
        "amount": { "type": "number" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userUid", "type", "amount", "title"]
    },
    "Product": {
      "title": "Product",
      "description": "Kingdom Store digital products.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "collectionName": { "type": "string" },
        "coverUrl": { "type": "string" },
        "fileUrl": { "type": "string" },
        "priceKC": { "type": "number" },
        "author": { "type": "string" },
        "tags": { "type": "array" },
        "featured": { "type": "boolean" },
        "published": { "type": "boolean" },
        "downloadable": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "category", "priceKC", "published"]
    },
    "UserReward": {
      "title": "UserReward",
      "description": "Digital product or theme owned by the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userUid": { "type": "string" },
        "itemId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "kcCost": { "type": "number" },
        "fileUrl": { "type": "string" },
        "claimedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userUid", "itemId", "title"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Feed post, testimony, or announcement.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "authorPhotoURL": { "type": "string" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "mediaFileId": { "type": "string" },
        "likesCount": { "type": "number" },
        "likes": { "type": "object" },
        "comments": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "text", "authorUid", "authorName"]
    },
    "FileChunk": {
      "title": "FileChunk",
      "description": "Base64 chunk slice for feed media, videos, pics, and super admin store files.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fileId": { "type": "string" },
        "chunkIndex": { "type": "number" },
        "totalChunks": { "type": "number" },
        "data": { "type": "string" },
        "mimeType": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fileId", "chunkIndex", "totalChunks", "data"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile store."
    },
    "mission_completions/{completionId}": {
      "schema": "MissionCompletion",
      "description": "Unique mission completion and reward prevention audit records."
    },
    "kc_transactions/{transactionId}": {
      "schema": "KcTransaction",
      "description": "Kingdom coin transaction credit and debit logs."
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Kingdom Store items for sale."
    },
    "user_rewards/{rewardId}": {
      "schema": "UserReward",
      "description": "Digital items and rewards unlocked by users."
    },
    "community_feed/{postId}": {
      "schema": "CommunityPost",
      "description": "Community posts, testimonies, and announcements."
    },
    "file_chunks/{chunkId}": {
      "schema": "FileChunk",
      "description": "Base64 chunk slices for files, pics, videos, and store resources."
    },
    "cells/{cellId}": {
      "schema": "User",
      "description": "Fellowship cell registries."
    },
    "prayer_petitions/{petitionId}": {
      "schema": "User",
      "description": "Intercession and prayer requests."
    },
    "custom_requests/{requestId}": {
      "schema": "User",
      "description": "Custom creation requests submitted by users."
    },
    "feedback_items/{feedbackId}": {
      "schema": "User",
      "description": "User suggestions and feedback items."
    }
  }
}
